# 敏感配置示例文件 —— 复制为 secrets.yaml 并填入真实凭据。
# secrets.yaml 已加入 .gitignore，不会被 Git 跟踪。
#
# 也支持通过环境变量覆盖（优先级高于本文件）：
#   - GOOGLE_APPLICATION_CREDENTIALS（BigQuery 服务账号 JSON 路径）

bigquery:
  # 方式1：通过 GOOGLE_APPLICATION_CREDENTIALS 环境变量指向服务账号 JSON 文件
  # （推荐，无需在此处填写）
  #
  # 方式2：在 secrets.yaml 中指定 credentials_path
  credentials_path: "config/bigquery-service-account.json"
