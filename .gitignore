# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# IDE
.vscode/
.idea/

# 运行时输出：每次回测会落到以下两处之一，默认都不入库
#   - 旧路径（无 --preset 时的兜底）：output/{timestamp}/
#   - 新路径（--preset 模式）：strategy/{name}/runs/{timestamp}/
# 如需长期保留某次回测，用 `git add -f` 强制收录具体文件即可。
output/
strategy/*/runs/

# 敏感配置（含 API Key 等凭据，禁止入库）
config/secrets.yaml

# 行情数据本地缓存：从 MaxCompute 拉取的 K 线、复权因子等都落盘到这里。
# 可重新生成（首次回测会触发 SQL 查询），不入库以避免泄露付费数据 + 仓库膨胀。
data/raw/
